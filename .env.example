# ---- Config Cop environment (server-side only) ----
# Copy to .env and fill in if you want real LLM explanations.
# The backend loads .env automatically; real OS environment variables override it.
# Any OpenAI-compatible /chat/completions endpoint works, plus Google Gemini.
# With LLM_PROVIDER=none the app uses the deterministic rule-based fallback.

# openai | groq | openrouter | together | gemini | ollama | custom | none
LLM_PROVIDER=none

# Example (Groq, open-weight model, OpenAI-compatible):
# LLM_PROVIDER=groq
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_API_KEY=gsk_xxx        # NEVER commit this; server-side only

# Example (Google Gemini, official Generative Language API):
# LLM_PROVIDER=gemini
# LLM_MODEL=gemini-3.5-flash-lite  # fast + reliable; gemini-3.5-flash also works
#                                  # (gemini-3.8-flash may return HTTP 503 under high demand)
# LLM_API_KEY=AIza_xxx        # Google AI Studio key; NEVER commit this
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta   # optional override

# Example (local Ollama, no key needed):
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1

# Optional override for any provider:
LLM_BASE_URL=
LLM_TIMEOUT=12

# Cluster ops: auto (use kubectl if a context exists) | simulated | real
#   real = require a live cluster (API returns a clear error if unreachable)
CLUSTER_MODE=auto
# Namespace + manifest used for reads / fixes / reset
CONFIGCOP_NAMESPACE=prod
# CONFIGCOP_MANIFEST=k8s/demo-workloads.yaml
SIMULATED_ROLLOUT_SECONDS=4
